import os
import re
import random
import pickle
import numpy as np
import pandas as pd
import fitz  # PyMuPDF
from tqdm import tqdm
from typing import List, Dict
from sklearn.metrics.pairwise import cosine_similarity
from sentence_transformers import SentenceTransformer
import spacy

# Initialize spaCy French model
try:
    nlp = spacy.load("fr_core_news_sm")
except OSError:
    print("Downloading French language model...")
    from spacy.cli import download
    download("fr_core_news_sm")
    nlp = spacy.load("fr_core_news_sm")

def text_formatter(text: str) -> str:
    """Clean text by removing extra whitespace and newlines"""
    return " ".join(text.split())

def open_and_read_pdf(pdf_path: str) -> List[Dict]:
    """Extract text and metadata from PDF"""
    if not os.path.exists(pdf_path):
        raise FileNotFoundError(f"PDF file not found at: {pdf_path}")

    doc = fitz.open(pdf_path)
    pages_content = []

    for page_index, page in enumerate(tqdm(doc, desc="Processing PDF")):
        text = page.get_text()
        if not text.strip():
            continue

        text = text_formatter(text)
        doc = nlp(text)
        
        page_dict = {
            "page_number": page_index + 1,
            "text": text,
            "sentences": list(doc.sents),
            "page_sentences_count": len(list(doc.sents))
        }
        pages_content.append(page_dict)
    
    return pages_content

def create_sentence_chunks(pages_content: List[Dict], sentences_per_chunk: int = 3) -> List[Dict]:
    """Create sentence chunks from processed pages"""
    pages_sentence_chunks = []
    
    for item in tqdm(pages_content, desc="Creating chunks"):
        sentences = [str(sent) for sent in item["sentences"]]
        
        for i in range(0, len(sentences), sentences_per_chunk):
            chunk = sentences[i:i+sentences_per_chunk]
            joined_chunk = " ".join(chunk)
            
            chunk_dict = {
                "page_number": item["page_number"],
                "sentence_chunk": joined_chunk,
                "chunk_char_count": len(joined_chunk),
                "chunk_word_count": len(joined_chunk.split()),
                "chunk_token_count": len(joined_chunk) / 4  # Approximation
            }
            pages_sentence_chunks.append(chunk_dict)
    
    return pages_sentence_chunks

def generate_embeddings(chunks: List[Dict], model_name: str = 'all-mpnet-base-v2') -> tuple:
    """Generate embeddings for text chunks"""
    model = SentenceTransformer(model_name)
    text_chunks = [chunk["sentence_chunk"] for chunk in chunks]
    embeddings = model.encode(text_chunks)
    
    # Add embeddings to chunks
    for i, chunk in enumerate(chunks):
        chunk["embedding"] = embeddings[i]
    
    return chunks, embeddings

def find_similar_chunks(query: str, chunks: List[Dict], embeddings: np.ndarray, top_k: int = 3):
    """Find similar chunks to a query"""
    model = SentenceTransformer('all-mpnet-base-v2')
    query_embedding = model.encode(query)
    
    similarities = cosine_similarity([query_embedding], embeddings)[0]
    most_similar_indices = np.argsort(similarities)[-top_k:][::-1]
    
    print(f"\nTop {top_k} results for: '{query}'\n")
    for idx in most_similar_indices:
        print(f"Score: {similarities[idx]:.4f} | Page {chunks[idx]['page_number']}")
        print(chunks[idx]['sentence_chunk'])
        print("-" * 80)

def main():
    # Configuration
    PDF_PATH = "Règlement_intérieur_ARE.pdf"
    SENTENCES_PER_CHUNK = 3
    MIN_TOKEN_LENGTH = 30
    
    # 1. Process PDF
    print("Starting PDF processing...")
    pages_content = open_and_read_pdf(PDF_PATH)
    
    # 2. Create sentence chunks
    pages_sentence_chunks = create_sentence_chunks(pages_content, SENTENCES_PER_CHUNK)
    
    # 3. Show sample chunks
    df = pd.DataFrame(pages_sentence_chunks)
    filtered_df = df[df["chunk_token_count"] <= MIN_TOKEN_LENGTH]
    
    print("\nSample chunks from the ARE regulations:")
    if filtered_df.empty:
        print(f"No chunks found with token count ≤ {MIN_TOKEN_LENGTH}")
    else:
        for _, row in filtered_df.sample(min(3, len(filtered_df))).iterrows():
            print(f"\nChunk (Page {row['page_number']})")
            print(f"Tokens: {row['chunk_token_count']:.1f}, Words: {row['chunk_word_count']}")
            print(row['sentence_chunk'])
            print("-" * 80)
    
    # 4. Generate embeddings
    if len(pages_sentence_chunks) > 0:
        print("\nGenerating embeddings...")
        chunks_with_embeddings, embeddings = generate_embeddings(pages_sentence_chunks)
        
        # Save embeddings
        with open('are_embeddings.pkl', 'wb') as f:
            pickle.dump({
                'chunks': chunks_with_embeddings,
                'embeddings': embeddings,
                'model': 'all-mpnet-base-v2'
            }, f)
        print("Embeddings saved to are_embeddings.pkl")
        
        # Example searches specific to ARE document
        example_queries = [
            "Quelles sont les règles pour les nouveaux membres?",
            "Comment fonctionne le bureau exécutif?",
            "Quelles sont les conséquences d'une absence non justifiée?"
        ]
        
        for query in example_queries:
            find_similar_chunks(query, chunks_with_embeddings, embeddings)
    else:
        print("No chunks available for embedding")

if __name__ == "__main__":
    main()